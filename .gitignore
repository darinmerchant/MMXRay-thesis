# Data: never in git. Raw sources are staged under data/raw/, registries are
# rebuilt by data/builders/*.py, banked view blocks by tools/bank_pdf.py.
data/raw/
data/registry/
data/downstream/
data/banked/
*.parquet

# Model checkpoints and run outputs: every run tree lives under runs/.
*.pt
*.ckpt
runs/
# Except the two encoders the thesis reports, released under checkpoints/.
!checkpoints/**/*.pt
wandb/

# Generated figures and analysis summaries (regenerated by tools/ and analysis/).
/figures/
analysis/out/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Conda envs built from environment.yml
env/
envs/

# OS / editor
.DS_Store
.claude/
